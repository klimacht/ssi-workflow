# ============================================================
# Hydroxylated tyrosines in Phl p 5a (Y65 -> L-DOPA, further sites,
# TOPA), sourced after config/workflow.env. See dopa/README.md.
# ============================================================

# Input structure: cleaned AlphaFold 3 model of Phl p 5a (heavy atoms)
DOPA_SRC_PDB=${SSI_ROOT}/examples/PHLP5/PHLP5_input.pdb

# Simulated domain (helical domain 1); the neighbouring residues
# DOPA_FIRST-1 and DOPA_LAST+1 become ACE / NME caps
DOPA_FIRST=34
DOPA_LAST=144
# site of the short system names dah_ce1 / dah_ce2
DOPA_MUT=65

# Systems (see src/make_system_pdb.py): wt; y<N>_<dah|top>_<ce1|ce2> with the
# new 3-OH on the ring carbon named CE1 / CE2 in the model; dah_ce1/2 = Y65;
# x<A>_<B> = 3,3'-dityrosine cross-link between Tyr A and Tyr B
DOPA_SYSTEMS="wt dah_ce1 dah_ce2 y112_dah_ce1 y112_dah_ce2 y127_dah_ce1 y127_dah_ce2 y65_top_ce1 y65_top_ce2 x65_127"

# Analysis groups: one comparison per modified site (WT + all systems of that
# site); partners = the other tyrosines of the Y65/Y112/Y124/Y127 cluster
DOPA_SITES="65 112 127"
DOPA_CLUSTER="65 112 124 127"
# helix containing each site (helicity metric of the analysis)
DOPA_SITE_HELIX="65=64:84 112=91:116 127=123:140"

# Force field (GROMACS built-in, hydroxylated Tyr added by dopa/ff/make_ff.sh)
DOPA_BASE_FF=amber99sb-ildn
DOPA_WATER=tip3p
DOPA_BOX_NM=1.2
DOPA_SALT_M=0.15

# Replicas per system (run together with mdrun -multidir)
DOPA_NREP=4
DOPA_SEED_BASE=1000

# Production: nodes per system (4 = one node per replica, ~2.6x faster than
# 1 node, benchmark 2026-10-27) and resubmissions (12 h jobs)
DOPA_PROD_NODES=4
DOPA_MAX_RESUBMIT=20

# Output
DOPA_RUNS=${SSI_ROOT}/runs/dopa

# Analysis
DOPA_SKIP_NS=50
# systems for the exposure of the reactive Tyr atoms and the Tyr-Tyr contacts
# (src/tyr_exposure.py, compared with Table 1 and the modification degrees of the paper)
DOPA_EXPOSURE_SYSTEMS="wt"

# Figures and movies (dopa/slurm/16_render.slurm): PyMOL from a conda env (as for the SSI
# maps, scripts/render_maps_pymol.py), ffmpeg module (needs MODULE_GCC loaded first)
DOPA_CONDA_SH=/mpcdf/soft/RHEL_9/packages/x86_64/anaconda/3/2023.03/etc/profile.d/conda.sh
DOPA_PYMOL_ENV=/u/${USER}/conda-envs/pymol_env
DOPA_MODULE_FFMPEG=ffmpeg/7.1

# QM/MM single points on MD frames (dopa/slurm/17_qmmm.slurm, src/qmmm_tyr.py): ionisation and
# deprotonation energy of each Tyr in the protein field, hole distribution in the triad
DOPA_QMMM_SYSTEM=wt
DOPA_QMMM_FRAMES=10                 # per replica, evenly spread over t >= DOPA_SKIP_NS
DOPA_QMMM_SITES="65 108 112 124 127"
DOPA_QMMM_TRIAD="65 127 112"        # edge-to-face chain in the WT (Y65-Y127 53 %, Y112-Y127 25 %)
DOPA_QMMM_XC=wb97x                  # range-separated hybrid: less spurious hole delocalisation than B3LYP
DOPA_QMMM_BASIS=6-31+g*             # diffuse functions for the phenolate
DOPA_QMMM_PARALLEL=8                # array tasks running at the same time, per array (sites, triad)
DOPA_QMMM_TIME_SITES=03:00:00       # five Tyr x 2 environments x 4 states; ~1.5 h on the workstation (32 threads)
DOPA_QMMM_TIME_TRIAD=10:00:00       # neutral + cation x 2 environments, 480 basis functions; check after the test task

# Monitor plots (dopa/bin/dopa_monitor.sh)
MODULE_GNUPLOT=gnuplot/6.0

# QM for the RESP charges (dopa/slurm/10_resp_qm.slurm): venv with PySCF +
# geomeTRIC, created once with dopa/params/make_qm_venv.sh
DOPA_QM_VENV=/ptmp/${USER}/venvs/qm
